// Cloudflare Pages 配置文件
// 仅供 `wrangler pages deploy` 命令读取,Git 集成部署的构建设置在 Cloudflare 控制台
// 文档: https://developers.cloudflare.com/pages/functions/wrangler-configuration/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hs-puzzle",
  "pages_build_output_dir": "dist",

  // D1 排行榜数据库绑定
  // 部署前需先执行:
  //   wrangler d1 create hs-puzzle-leaderboard    -> 拿到 database_id 填到下面
  //   wrangler d1 execute hs-puzzle-leaderboard --file=db/schema.sql --remote
  // 本地开发可使用 --local: wrangler d1 execute hs-puzzle-leaderboard --file=db/schema.sql --local
  "d1_databases": [
    {
      "binding": "LEADERBOARD_DB",
      "database_name": "hs-puzzle-leaderboard",
      "database_id": "7ed013c0-aab6-4539-91df-ee5bc15363e4"
    }
  ]
}
